# ========================================================
# VELOCITY JAPANESE - Social Media Automation Configuration
# ========================================================

# Google Drive Configuration
# Folder ID: https://drive.google.com/drive/folders/1o2ntZzxWTogxmK43rPt9Hx1kEzMjLdRf
GOOGLE_DRIVE_FOLDER_ID=1o2ntZzxWTogxmK43rPt9Hx1kEzMjLdRf
# Path to service account json file OR paste entire raw JSON content string
GOOGLE_SERVICE_ACCOUNT_KEY=service_account.json
LOCAL_INPUT_DIR=Videos

# Facebook Graph API (Velocity Japanese Page)
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token

# Optional: Instagram Graph API
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Optional: Threads API
THREADS_USER_ID=your_threads_user_id
THREADS_ACCESS_TOKEN=your_threads_access_token

# Optional: YouTube Shorts
YT_CLIENT_ID=your_youtube_client_id
YT_CLIENT_SECRET=your_youtube_client_secret
YT_REFRESH_TOKEN=your_youtube_refresh_token

# AI Caption Generation (Pollinations AI)
POLLINATIONS_API_KEY=your_pollinations_api_key
AI_MODEL=openai

# Video Processing (ffmpeg)
REMOVE_WATERMARK=false
